# Secret pour signer les cookies de session (32+ caractères aléatoires)
SESSION_SECRET=change-me

# URL publique du site (utilisée pour le callback OAuth Strava)
APP_URL=http://localhost:3000

# Strava API — créer une app sur https://www.strava.com/settings/api
# "Authorization Callback Domain" : localhost (ou ton domaine en prod)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
